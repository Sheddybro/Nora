{
  "expo": {
    "name": "NorrisBeauty",
    "slug": "norrisbeauty",
    "scheme": "norrisbeauty",
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "orientation": "default",
    "icon": "./assets/norris-logo.jpeg",
    "splash": {
      "image": "./assets/norris-logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.norrisbeauty.app"
    }
  }
}
