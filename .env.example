DJANGO_ENV=development
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-that-is-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,192.168.1.10
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://0.0.0.0:8000,http://192.168.1.10:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DATABASE_URL=sqlite:///db.sqlite3
